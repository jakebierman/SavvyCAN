  {
    "id": "dbc_signals",
    "title": "DBC databases, messages and signals",
    "package": "skills/savvycan-dbc-signals",
    "triggers": [
      "dbc", "database", "signal", "message definition", "node", "scaling",
      "start bit", "bitfield", "byte field", "enum", "status bits",
      "multiplex", "multiplexor"
    ],
    "workspaces": ["dbc"],
    "capabilities": [
      "ui.open",
      "dbc.load",
      "dbc.create",
      "dbc.save",
      "dbc.close",
      "dbc.assign_bus",
      "dbc.add_node",
      "dbc.remove_node",
      "dbc.add_message",
      "dbc.update_message",
      "dbc.remove_message",
      "dbc.add_signal",
      "dbc.update_signal",
      "dbc.remove_signal"
    ],
    "rules": [
      "A DBC CAN ID identifies a message; signal start bits and lengths identify payload fields.",
      "Use byte_offset and byte_length only for byte-aligned fields; use start_bit and bit_length for arbitrary bitfields.",
      "Use values for discrete enum/status mappings and multiplex_role, multiplex_values and multiplex_parent for multiplexed messages.",
      "Combine this skill with reverse_engineering when Sniffer evidence is used to create or update signals.",
      "Never invent scaling, byte order, signedness or units when evidence is absent."
    ],
    "examples": [
      {
        "user": "add a little endian unsigned 16 bit coolant field at byte 2 to message 0x321",
        "capability": "dbc.add_signal",
        "arguments": {
          "file_index": 0,
          "can_id": "0x321",
          "name": "CoolantTemperature",
          "byte_offset": 2,
          "byte_length": 2,
          "little_endian": true,
          "value_type": "unsigned",
          "factor": 0.1,
          "offset": -40,
          "unit": "deg C"
        }
      }
    ]
  },
