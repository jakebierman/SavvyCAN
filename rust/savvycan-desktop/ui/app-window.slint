import { Button, CheckBox, LineEdit, HorizontalBox, VerticalBox, ListView } from "std-widgets.slint";

export struct FrameRow {
    timestamp: string,
    channel: string,
    can-id: string,
    direction: string,
    format: string,
    length: string,
    payload: string,
    message-name: string,
    decoded-values: string,
    typed-values: string,
}

export struct IsoTpRow {
    timestamp: string,
    channel: string,
    can-id: string,
    direction: string,
    length: string,
    payload: string,
    summary: string,
}

export struct StatsRow {
    channel: string,
    can-id: string,
    count: string,
    classic: string,
    fd: string,
    remote: string,
    payload-bytes: string,
    first: string,
    last: string,
    mean-period: string,
    hz: string,
}

export struct BamRow {
    timestamp: string,
    channel: string,
    source: string,
    pgn: string,
    length: string,
    payload: string,
}

export struct ByteActivityRow {
    channel: string,
    can-id: string,
    position: string,
    samples: string,
    distinct: string,
    changes: string,
    flips: string,
    last: string,
}

export component AppWindow inherits Window {
    title: "SavvyCAN — Rust Preview";
    preferred-width: 1720px;
    preferred-height: 760px;
    background: #101722;

    in-out property <string> file-path: "";
    in-out property <string> dbc-path: "";
    in-out property <string> format-spec: "";
    in-out property <string> rules-path: "";
    in-out property <string> export-path: "";
    in-out property <bool> export-matching: false;
    in-out property <string> live-interface: "can0";
    in-out property <string> serial-path: "";
    in-out property <string> serial-baud: "115200";
    in-out property <string> serial-interface: "slcan0";
    in-out property <string> filter-interface: "";
    in-out property <string> filter-id: "";
    in-out property <string> filter-from: "";
    in-out property <string> filter-through: "";
    in-out property <string> filter-payload: "";
    in-out property <string> isotp-interface: "";
    in-out property <string> isotp-id: "S:7E8";
    in-out property <bool> show-isotp: false;
    in-out property <bool> show-stats: false;
    in-out property <bool> show-bam: false;
    in-out property <bool> show-bytes: false;
    in-out property <bool> show-plot: false;
    in-out property <string> plot-interface: "";
    in-out property <string> plot-id: "S:123";
    in-out property <string> plot-signal: "RPM";
    in-out property <string> replay-speed: "1";
    in property <string> plot-commands: "";
    in property <string> plot-summary: "";
    in-out property <string> byte-interface: "";
    in-out property <string> byte-id: "";
    in property <[ByteActivityRow]> byte-rows: [];
    in property <string> byte-summary: "";
    in-out property <string> bam-interface: "";
    in-out property <string> bam-source: "";
    in property <string> isotp-summary: "No ISO-TP inspection performed";
    in property <[IsoTpRow]> isotp-rows: [];
    in property <[StatsRow]> stats-rows: [];
    in property <[BamRow]> bam-rows: [];
    in property <string> bam-summary: "";
    in property <string> stats-summary: "";
    in property <string> status-text: "Enter a CAN trace path to inspect an offline trace.";
    in property <string> page-text: "No trace loaded";
    in property <[FrameRow]> frames: [];
    callback open-trace(string, string, string, string);
    callback browse-trace();
    callback browse-dbc();
    callback browse-rules();
    callback browse-export();
    callback export-trace(string, bool);
    callback start-live(string, string, string, string);
    callback stop-live();
    callback start-slcan(string, string, string, string, string, string);
    callback start-gvret-serial(string, string, string, string, string);
    callback apply-filter(string, string, string, string, string);
    callback previous-page();
    callback next-page();
    callback inspect-isotp(string, string);
    callback open-statistics();
    callback inspect-bam(string, string);
    callback inspect-bytes(string, string);
    callback plot-signal-series(string, string, string);
    callback play-replay(string);
    callback pause-replay();
    callback step-replay();
    callback stop-replay();

    VerticalBox {
        padding: 16px;
        spacing: 12px;

        Text {
            text: "SavvyCAN";
            color: #e7f2ff;
            font-size: 26px;
            font-weight: 700;
        }

        Text {
            text: "Rust / Slint — CAN trace, DBC decoder and typed payload formatter";
            color: #8da4bf;
            font-size: 14px;
        }

        HorizontalBox {
            spacing: 8px;
            LineEdit {
                text <=> root.file-path;
                placeholder-text: "Path to CAN trace (.log, .trc, .asc, .crtd, .csv)";
            }
            Button { text: "Browse"; clicked => { root.browse-trace(); } }
            LineEdit {
                text <=> root.dbc-path;
                placeholder-text: "DBC associations: file.dbc;can0=other.dbc";
            }
            Button { text: "DBC files"; clicked => { root.browse-dbc(); } }
            Button {
                text: "Open trace";
                clicked => { root.open-trace(root.file-path, root.dbc-path, root.format-spec, root.rules-path); }
            }
        }

        LineEdit {
            text <=> root.format-spec;
            placeholder-text: "Optional default typed format (e.g. rpm:u16be@0/4[rpm]{1} temp:i8@2-40[C])";
        }

        HorizontalBox {
            spacing: 8px;
            LineEdit {
                text <=> root.rules-path;
                placeholder-text: "Optional per-interface/CAN-ID formatter rules file";
            }
            Button { text: "Browse"; clicked => { root.browse-rules(); } }
            LineEdit {
                text <=> root.export-path;
                placeholder-text: "New export (.crtd, .csv, .log, .pcap, .pcapng, .stats.csv, .bytes.csv, .signals.csv)";
            }
            Button { text: "Save as"; clicked => { root.browse-export(); } }
            CheckBox {
                text: "Only matching";
                checked <=> root.export-matching;
            }
            Button {
                text: "Export trace";
                clicked => { root.export-trace(root.export-path, root.export-matching); }
            }
        }

        HorizontalBox {
            spacing: 8px;
            LineEdit {
                text <=> root.live-interface;
                placeholder-text: "Linux SocketCAN interface (can0 or vcan0)";
            }
            Button {
                text: "Start receive-only capture";
                clicked => {
                    root.start-live(root.live-interface, root.dbc-path,
                        root.format-spec, root.rules-path);
                }
            }
            Button {
                text: "Stop";
                clicked => { root.stop-live(); }
            }
        }


        HorizontalBox {
            spacing: 8px;
            LineEdit {
                text <=> root.serial-path;
                placeholder-text: "Preconfigured SLCAN serial path (e.g. /dev/ttyUSB0)";
            }
            LineEdit {
                text <=> root.serial-baud;
                placeholder-text: "Serial baud (e.g. 115200)";
            }
            LineEdit {
                text <=> root.serial-interface;
                placeholder-text: "SLCAN interface label";
            }
            Button {
                text: "Start SLCAN receive-only";
                clicked => { root.start-slcan(root.serial-path, root.serial-baud,
                    root.serial-interface, root.dbc-path, root.format-spec, root.rules-path); }
            }
            Button {
                text: "Start GVRET stream";
                clicked => { root.start-gvret-serial(root.serial-path, root.serial-baud,
                    root.dbc-path, root.format-spec, root.rules-path); }
            }
        }

        HorizontalBox {
            spacing: 8px;
            LineEdit {
                text <=> root.filter-interface;
                placeholder-text: "Filter interface (blank = all)";
            }
            LineEdit {
                text <=> root.filter-id;
                placeholder-text: "Filter CAN ID / range / mask / PGN (S:123, X:18FF0000/1FFF0000)";
            }
            LineEdit {
                text <=> root.filter-from;
                placeholder-text: "From time (seconds)";
            }
            LineEdit {
                text <=> root.filter-through;
                placeholder-text: "Through time (seconds)";
            }
            LineEdit {
                text <=> root.filter-payload;
                placeholder-text: "Payload contains hex bytes (22 F1 ?? 90)";
            }
            Button {
                text: "Apply filter";
                clicked => { root.apply-filter(root.filter-interface, root.filter-id,
                    root.filter-from, root.filter-through, root.filter-payload); }
            }
        }

        HorizontalBox {
            spacing: 8px;
            Button {
                text: "Previous 1,000";
                clicked => { root.previous-page(); }
            }
            Button {
                text: "Next 1,000";
                clicked => { root.next-page(); }
            }
            Text {
                text: root.page-text;
                color: #9fcaee;
                font-size: 13px;
            }
        }


        HorizontalBox {
            spacing: 8px;
            Text {
                text: "Offline replay (no CAN TX)";
                color: #9cdbc1;
            }
            LineEdit {
                text <=> root.replay-speed;
                placeholder-text: "Speed 0.1–100x";
                width: 130px;
            }
            Button { text: "Play"; clicked => { root.play-replay(root.replay-speed); } }
            Button { text: "Pause"; clicked => { root.pause-replay(); } }
            Button { text: "Step +1"; clicked => { root.step-replay(); } }
            Button { text: "Stop / Full trace"; clicked => { root.stop-replay(); } }
        }

        HorizontalBox {
            spacing: 8px;
            LineEdit {
                text <=> root.isotp-interface;
                placeholder-text: "ISO-TP interface (blank = all)";
            }
            LineEdit {
                text <=> root.isotp-id;
                placeholder-text: "Exact ISO-TP ID, e.g. S:7E8 or X:18DAF110";
            }
            Button {
                text: "Inspect passive ISO-TP";
                clicked => { root.inspect-isotp(root.isotp-interface, root.isotp-id); }
            }
            Button {
                text: "Traffic statistics";
                clicked => { root.open-statistics(); }
            }
            Button {
                text: "Trace frames";
                clicked => {
                    root.show-isotp = false;
                    root.show-stats = false;
                    root.show-bam = false;
                    root.show-bytes = false;
                    root.show-plot = false;
                }
            }
        }

        HorizontalBox {
            spacing: 8px;
            LineEdit {
                text <=> root.bam-interface;
                placeholder-text: "J1939 BAM interface (blank = all)";
            }
            LineEdit {
                text <=> root.bam-source;
                placeholder-text: "J1939 source address hex (e.g. 80; blank = all)";
            }
            Button {
                text: "Inspect J1939 BAM";
                clicked => { root.inspect-bam(root.bam-interface, root.bam-source); }
            }
        }

        HorizontalBox {
            spacing: 8px;
            LineEdit {
                text <=> root.byte-interface;
                placeholder-text: "Byte activity interface (blank = all)";
            }
            LineEdit {
                text <=> root.byte-id;
                placeholder-text: "Byte activity ID / range / PGN (blank = all)";
            }
            Button {
                text: "Inspect byte activity";
                clicked => { root.inspect-bytes(root.byte-interface, root.byte-id); }
            }
        }

        HorizontalBox {
            spacing: 8px;
            LineEdit {
                text <=> root.plot-interface;
                placeholder-text: "DBC plot interface (blank = all)";
            }
            LineEdit {
                text <=> root.plot-id;
                placeholder-text: "Exact plot CAN ID (S:123)";
            }
            LineEdit {
                text <=> root.plot-signal;
                placeholder-text: "DBC signal name (e.g. RPM)";
            }
            Button {
                text: "Plot DBC signal";
                clicked => { root.plot-signal-series(root.plot-interface, root.plot-id, root.plot-signal); }
            }
        }

        if root.show-isotp : Text {
            text: root.isotp-summary;
            color: #9cdbc1;
            font-size: 13px;
        }

        if root.show-bam : Text {
            text: root.bam-summary;
            color: #9cdbc1;
            font-size: 13px;
        }
        if root.show-stats : Text {
            text: root.stats-summary;
            color: #9cdbc1;
            font-size: 13px;
        }

        if root.show-bytes : Text {
            text: root.byte-summary;
            color: #9cdbc1;
            font-size: 13px;
        }

        if root.show-plot : Text {
            text: root.plot-summary;
            color: #9cdbc1;
            font-size: 13px;
        }

        Text {
            text: root.status-text;
            color: #9fcaee;
            font-size: 13px;
        }

        if !root.show-isotp && !root.show-stats && !root.show-bam && !root.show-bytes && !root.show-plot : Rectangle {
            height: 34px;
            background: #243247;
            HorizontalBox {
                padding-left: 8px;
                spacing: 8px;
                Text { text: "Timestamp"; width: 158px; color: #f2f6ff; }
                Text { text: "Interface"; width: 85px; color: #f2f6ff; }
                Text { text: "CAN ID"; width: 100px; color: #f2f6ff; }
                Text { text: "Rx/Tx"; width: 60px; color: #f2f6ff; }
                Text { text: "Format"; width: 75px; color: #f2f6ff; }
                Text { text: "DLC"; width: 42px; color: #f2f6ff; }
                Text { text: "Payload"; width: 235px; color: #f2f6ff; }
                Text { text: "Message"; width: 165px; color: #f2f6ff; }
                Text { text: "DBC signals"; width: 350px; color: #f2f6ff; }
                Text { text: "Typed values"; color: #f2f6ff; }
            }
        }

        if root.show-isotp : Rectangle {
            height: 34px;
            background: #243247;
            HorizontalBox {
                padding-left: 8px;
                spacing: 8px;
                Text { text: "End timestamp"; width: 158px; color: #f2f6ff; }
                Text { text: "Interface"; width: 90px; color: #f2f6ff; }
                Text { text: "CAN ID"; width: 100px; color: #f2f6ff; }
                Text { text: "Direction"; width: 115px; color: #f2f6ff; }
                Text { text: "Bytes"; width: 55px; color: #f2f6ff; }
                Text { text: "Reassembled payload (first 64 bytes)"; width: 625px; color: #f2f6ff; }
                Text { text: "UDS-like hint"; color: #f2f6ff; }
            }
        }


        if root.show-bytes : Rectangle {
            height: 34px;
            background: #243247;
            HorizontalBox {
                padding-left: 8px;
                spacing: 8px;
                Text { text: "Interface"; width: 130px; color: #f2f6ff; }
                Text { text: "CAN ID"; width: 140px; color: #f2f6ff; }
                Text { text: "Byte"; width: 80px; color: #f2f6ff; }
                Text { text: "Samples"; width: 110px; color: #f2f6ff; }
                Text { text: "Distinct values"; width: 155px; color: #f2f6ff; }
                Text { text: "Changed pairs"; width: 155px; color: #f2f6ff; }
                Text { text: "Bit flips"; width: 120px; color: #f2f6ff; }
                Text { text: "Last value (hex)"; color: #f2f6ff; }
            }
        }

        if root.show-stats : Rectangle {
            height: 34px;
            background: #243247;
            HorizontalBox {
                padding-left: 8px;
                spacing: 8px;
                Text { text: "Interface"; width: 100px; color: #f2f6ff; }
                Text { text: "CAN ID"; width: 110px; color: #f2f6ff; }
                Text { text: "Frames"; width: 90px; color: #f2f6ff; }
                Text { text: "Classic"; width: 80px; color: #f2f6ff; }
                Text { text: "FD"; width: 70px; color: #f2f6ff; }
                Text { text: "RTR"; width: 70px; color: #f2f6ff; }
                Text { text: "Bytes"; width: 105px; color: #f2f6ff; }
                Text { text: "First (s)"; width: 158px; color: #f2f6ff; }
                Text { text: "Last (s)"; width: 158px; color: #f2f6ff; }
                Text { text: "Mean interval (µs)"; width: 165px; color: #f2f6ff; }
                Text { text: "Estimated Hz"; color: #f2f6ff; }
            }
        }


        if root.show-bam : Rectangle {
            height: 34px;
            background: #243247;
            HorizontalBox {
                padding-left: 8px;
                spacing: 8px;
                Text { text: "End timestamp"; width: 158px; color: #f2f6ff; }
                Text { text: "Interface"; width: 110px; color: #f2f6ff; }
                Text { text: "Source ECU"; width: 100px; color: #f2f6ff; }
                Text { text: "Target PGN"; width: 110px; color: #f2f6ff; }
                Text { text: "Bytes"; width: 65px; color: #f2f6ff; }
                Text { text: "Reassembled J1939 broadcast data (first 64 bytes)"; color: #f2f6ff; }
            }
        }

        if !root.show-isotp && !root.show-stats && !root.show-bam && !root.show-bytes && !root.show-plot : ListView {
            for frame[i] in root.frames: Rectangle {
                height: 30px;
                width: parent.width;
                background: Math.mod(i, 2) == 0 ? #182233 : #131e2d;
                HorizontalBox {
                    padding-left: 8px;
                    spacing: 8px;
                    Text { text: frame.timestamp; width: 158px; color: #b9d2ed; }
                    Text { text: frame.channel; width: 85px; color: #c5d7eb; }
                    Text { text: frame.can-id; width: 100px; color: #68d9d5; }
                    Text { text: frame.direction; width: 60px; color: #d5e1ee; }
                    Text { text: frame.format; width: 75px; color: #d5e1ee; }
                    Text { text: frame.length; width: 42px; color: #d5e1ee; }
                    Text { text: frame.payload; width: 235px; color: #e5edf5; }
                    Text { text: frame.message-name; width: 165px; color: #e3b86b; }
                    Text { text: frame.decoded-values; width: 350px; color: #9cdbc1; }
                    Text { text: frame.typed-values; color: #d9bbec; }
                }
            }
        }

        if root.show-isotp : ListView {
            for packet[i] in root.isotp-rows: Rectangle {
                height: 30px;
                width: parent.width;
                background: Math.mod(i, 2) == 0 ? #182233 : #131e2d;
                HorizontalBox {
                    padding-left: 8px;
                    spacing: 8px;
                    Text { text: packet.timestamp; width: 158px; color: #b9d2ed; }
                    Text { text: packet.channel; width: 90px; color: #c5d7eb; }
                    Text { text: packet.can-id; width: 100px; color: #68d9d5; }
                    Text { text: packet.direction; width: 115px; color: #d5e1ee; }
                    Text { text: packet.length; width: 55px; color: #d5e1ee; }
                    Text { text: packet.payload; width: 625px; color: #e5edf5; }
                    Text { text: packet.summary; color: #9cdbc1; }
                }
            }
        }



        if root.show-bam : ListView {
            for message[i] in root.bam-rows: Rectangle {
                height: 30px;
                width: parent.width;
                background: Math.mod(i, 2) == 0 ? #182233 : #131e2d;
                HorizontalBox {
                    padding-left: 8px;
                    spacing: 8px;
                    Text { text: message.timestamp; width: 158px; color: #b9d2ed; }
                    Text { text: message.channel; width: 110px; color: #c5d7eb; }
                    Text { text: message.source; width: 100px; color: #68d9d5; }
                    Text { text: message.pgn; width: 110px; color: #e3b86b; }
                    Text { text: message.length; width: 65px; color: #f2f6ff; }
                    Text { text: message.payload; color: #9cdbc1; }
                }
            }
        }

        if root.show-plot : Rectangle {
            height: 340px;
            width: parent.width;
            background: #151f2d;
            border-color: #35445b;
            border-width: 1px;
            border-radius: 7px;
            Path {
                x: 20px;
                y: 20px;
                width: parent.width - 40px;
                height: parent.height - 40px;
                commands: root.plot-commands;
                fill: transparent;
                stroke: #65d8cf;
                stroke-width: 2px;
            }
        }

        if root.show-bytes : ListView {
            for byte[i] in root.byte-rows: Rectangle {
                height: 30px;
                width: parent.width;
                background: Math.mod(i, 2) == 0 ? #182233 : #131e2d;
                HorizontalBox {
                    padding-left: 8px;
                    spacing: 8px;
                    Text { text: byte.channel; width: 130px; color: #c5d7eb; }
                    Text { text: byte.can-id; width: 140px; color: #68d9d5; }
                    Text { text: byte.position; width: 80px; color: #d5e1ee; }
                    Text { text: byte.samples; width: 110px; color: #f2f6ff; }
                    Text { text: byte.distinct; width: 155px; color: #d5e1ee; }
                    Text { text: byte.changes; width: 155px; color: #e3b86b; }
                    Text { text: byte.flips; width: 120px; color: #e3b86b; }
                    Text { text: byte.last; color: #9cdbc1; }
                }
            }
        }

        if root.show-stats : ListView {
            for stat[i] in root.stats-rows: Rectangle {
                height: 30px;
                width: parent.width;
                background: Math.mod(i, 2) == 0 ? #182233 : #131e2d;
                HorizontalBox {
                    padding-left: 8px;
                    spacing: 8px;
                    Text { text: stat.channel; width: 100px; color: #c5d7eb; }
                    Text { text: stat.can-id; width: 110px; color: #68d9d5; }
                    Text { text: stat.count; width: 90px; color: #f2f6ff; }
                    Text { text: stat.classic; width: 80px; color: #d5e1ee; }
                    Text { text: stat.fd; width: 70px; color: #d5e1ee; }
                    Text { text: stat.remote; width: 70px; color: #d5e1ee; }
                    Text { text: stat.payload-bytes; width: 105px; color: #e5edf5; }
                    Text { text: stat.first; width: 158px; color: #b9d2ed; }
                    Text { text: stat.last; width: 158px; color: #b9d2ed; }
                    Text { text: stat.mean-period; width: 165px; color: #e3b86b; }
                    Text { text: stat.hz; color: #9cdbc1; }
                }
            }
        }

        Text {
            text: "SLCAN or GVRET serial must already auto-stream • Opening a port may pulse DTR/reset devices • No CAN transmissions";
            color: #d6ab6b;
            font-size: 12px;
        }

        Text {
            text: "Offline paging • Export full capture or matched frames • Protocol and byte inspections use retained history • Receive-only";
            color: #8195aa;
            font-size: 12px;
        }
    }
}
