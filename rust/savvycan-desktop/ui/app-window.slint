import { Button, LineEdit, HorizontalBox, VerticalBox } from "std-widgets.slint";

export struct FrameRow {
    timestamp: string,
    channel: string,
    can-id: string,
    format: string,
    length: string,
    payload: string,
}

export component AppWindow inherits Window {
    title: "SavvyCAN — Rust Preview";
    preferred-width: 1180px;
    preferred-height: 720px;
    background: #101722;

    in-out property <string> file-path: "";
    in property <string> status-text: "Enter a candump log path to inspect an offline trace.";
    in property <[FrameRow]> frames: [];
    callback open-trace(string);

    VerticalBox {
        padding: 16px;
        spacing: 12px;

        Text {
            text: "SavvyCAN";
            color: #e7f2ff;
            font-size: 26px;
            font-weight: 700;
        }

        Text {
            text: "Rust / Slint — offline CAN trace viewer";
            color: #8da4bf;
            font-size: 14px;
        }

        HorizontalBox {
            spacing: 8px;
            LineEdit {
                text <=> root.file-path;
                placeholder-text: "Enter the path to a candump .log file";
            }
            Button {
                text: "Open trace";
                clicked => { root.open-trace(root.file-path); }
            }
        }

        Text {
            text: root.status-text;
            color: #9fcaee;
            font-size: 13px;
        }

        Rectangle {
            height: 34px;
            background: #243247;
            HorizontalBox {
                padding-left: 8px;
                spacing: 8px;
                Text { text: "Timestamp"; width: 165px; color: #f2f6ff; }
                Text { text: "Interface"; width: 105px; color: #f2f6ff; }
                Text { text: "CAN ID"; width: 120px; color: #f2f6ff; }
                Text { text: "Format"; width: 95px; color: #f2f6ff; }
                Text { text: "DLC"; width: 55px; color: #f2f6ff; }
                Text { text: "Payload"; color: #f2f6ff; }
            }
        }

        ListView {
            for frame[i] in root.frames: Rectangle {
                height: 30px;
                background: i % 2 == 0 ? #182233 : #131e2d;
                HorizontalBox {
                    padding-left: 8px;
                    spacing: 8px;
                    Text { text: frame.timestamp; width: 165px; color: #b9d2ed; }
                    Text { text: frame.channel; width: 105px; color: #c5d7eb; }
                    Text { text: frame.can-id; width: 120px; color: #68d9d5; }
                    Text { text: frame.format; width: 95px; color: #d5e1ee; }
                    Text { text: frame.length; width: 55px; color: #d5e1ee; }
                    Text { text: frame.payload; color: #e5edf5; }
                }
            }
        }

        Text {
            text: "Offline and read-only • No CAN hardware or frame transmission in this preview";
            color: #8195aa;
            font-size: 12px;
        }
    }
}
